///|
fn unicns_ucs2_h() -> Array[(Int32, Int32, Int32)] {
  let out : Array[(Int32, Int32, Int32)] = []
  for item in unicns_ucs2_h_0() {
    out.push(item)
  }
  for item in unicns_ucs2_h_1() {
    out.push(item)
  }
  for item in unicns_ucs2_h_2() {
    out.push(item)
  }
  for item in unicns_ucs2_h_3() {
    out.push(item)
  }
  for item in unicns_ucs2_h_4() {
    out.push(item)
  }
  for item in unicns_ucs2_h_5() {
    out.push(item)
  }
  out
}

///|
pub fn named_cmap(name : String) -> NamedCMap? {
  match name {
    "UniGB-UCS2-H" | "UniGB-UCS2-V" =>
      Some({ name: "UniGB-UCS2-H", code_bytes: 2, ranges: unigb_ucs2_h(), })
    "UniJIS-UCS2-H" | "UniJIS-UCS2-V" =>
      Some({ name: "UniJIS-UCS2-H", code_bytes: 2, ranges: unijis_ucs2_h(), })
    "UniKS-UCS2-H" | "UniKS-UCS2-V" =>
      Some({ name: "UniKS-UCS2-H", code_bytes: 2, ranges: uniks_ucs2_h(), })
    "UniCNS-UCS2-H" | "UniCNS-UCS2-V" =>
      Some({ name: "UniCNS-UCS2-H", code_bytes: 2, ranges: unicns_ucs2_h(), })
    _ => None
  }
}
